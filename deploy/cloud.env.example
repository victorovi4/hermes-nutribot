# Настройки выкладки приложения в Яндекс Облако. Скопируйте в deploy/cloud.env и заполните.

# Имена ресурсов в вашем облаке (создадутся сами)
NUTRI_FUNCTION=nutribot-api
NUTRI_GATEWAY=nutribot
NUTRI_TIMER=nutribot-warm
# Сервисный аккаунт облака, от имени которого всё работает
NUTRI_YC_SERVICE_ACCOUNT=hermes-agent

# Дневник: только Google-таблица (функция в облаке не достанет до базы на вашей машине)
NUTRI_SPREADSHEET_ID=
# Ключ служебного Google-аккаунта, которому открыта эта таблица
NUTRI_GOOGLE_SA_KEY=secrets/google-sa.key.json

# Кого пускать в приложение и от какого бота
TELEGRAM_ALLOWED_USERS=
TELEGRAM_BOT_TOKEN=
