# Домен приложения (A-запись должна указывать на этот сервер)
NUTRI_DOMAIN=nutribot.example.com

# Кого пускать: свой Telegram-id (узнать — написать @userinfobot). Через запятую, если несколько.
TELEGRAM_ALLOWED_USERS=123456789
# Токен бота — тот же, что у Hermes в профиле
TELEGRAM_BOT_TOKEN=

# Где дневник: sqlite (своя база) или sheets (Google-таблица)
NUTRI_STORAGE=sqlite
# Для sqlite: папка с базой НА СЕРВЕРЕ и имя файла (обычно папка профиля Hermes)
NUTRI_DB_HOST_DIR=/home/ubuntu/.hermes/profiles/nutrition
NUTRI_DB_FILE=nutribot.db
# Кто владеет этой папкой (id -u и id -g на сервере) — чтобы контейнер мог писать
NUTRI_UID=1000
NUTRI_GID=1000
# Для sheets: номер таблицы и ключ служебного Google-аккаунта в base64
NUTRI_SPREADSHEET_ID=
GOOGLE_SA_KEY_B64=
